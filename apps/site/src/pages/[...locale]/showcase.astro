---
/**
 * Showcase (ADR 0019): projects that use Deq. Each card shows a screenshot; the live
 * site loads in a sandboxed iframe only after a click, and the screenshot stays as the
 * fallback when it does not load.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getShape } from "@0xdolan/deq-core";

import IconGrid from "../../components/IconGrid.astro";
import { localePaths } from "../../i18n/index.ts";
import { pageContext } from "../../lib/page.ts";
import { PROJECTS, previewUrl, SANDBOX, screenshot, SHOT_WIDTHS } from "../../lib/showcase.ts";

export const getStaticPaths = localePaths;

const { locale, t } = pageContext(Astro.params.locale);
const SUBMIT = "https://github.com/kanilabs/deq/issues/new?template=showcase.yml";
const projects = PROJECTS.map((project) => ({
  ...project,
  preview: previewUrl(project.url),
  shot: screenshot(project.id),
  shapeData: project.shapes.map((id) => getShape(id)),
}));
---

<StarlightPage frontmatter={{ title: t("showcase.title"), description: t("showcase.description") }}>
  <p>{t("showcase.intro")}</p>
  <p class="deq-showcase-privacy">{t("showcase.privacy")}</p>

  <div class="deq-projects not-content">
    {projects.map((project, i) => (
      <article class="deq-project" id={project.id} aria-labelledby={`${project.id}-name`}>
        <div class="deq-preview" data-url={project.preview} data-title={project.name} data-sandbox={SANDBOX}>
          <img
            src={project.shot.src}
            srcset={project.shot.srcset}
            sizes="(min-width: 72rem) 30rem, 100vw"
            width={SHOT_WIDTHS[1]}
            height={800}
            alt={t("showcase.screenshot", { name: project.name })}
            loading={i < 2 ? "eager" : "lazy"}
            decoding="async"
          />
          <button type="button" class="deq-preview-load">{t("showcase.load", { name: project.name })}</button>
          <p class="deq-preview-fallback" role="status" hidden>{t("showcase.fallback")}</p>
        </div>
        <div class="deq-project-body">
          <h2 id={`${project.id}-name`} lang="en">{project.name}</h2>
          <p dir="auto">{project.description[locale]}</p>
          <h3>{t("showcase.shapes")}</h3>
          <IconGrid shapes={project.shapeData} locale={locale} />
          <p class="deq-project-links">
            <a href={project.preview} rel="noopener noreferrer">{t("showcase.open")}</a>
            {project.repo !== undefined && <a href={project.repo} rel="noopener noreferrer">{t("showcase.source")}</a>}
          </p>
        </div>
      </article>
    ))}
  </div>

  <h2>{t("showcase.submit.title")}</h2>
  <p>{t("showcase.submit.text")} <a href={SUBMIT} rel="noopener noreferrer">{t("showcase.submit.link")}</a></p>
</StarlightPage>

<script>
  /** Seconds to wait for a preview's `load` event before showing the fallback. */
  const TIMEOUT = 15_000;

  for (const preview of document.querySelectorAll<HTMLElement>(".deq-preview")) {
    const button = preview.querySelector("button");
    const fallback = preview.querySelector<HTMLElement>(".deq-preview-fallback");
    const url = preview.dataset["url"] ?? "";
    if (button === null || fallback === null || !url.startsWith("https://")) continue;
    button.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.setAttribute("sandbox", preview.dataset["sandbox"] ?? "");
      frame.referrerPolicy = "no-referrer";
      frame.loading = "lazy";
      frame.title = preview.dataset["title"] ?? "";
      const timer = window.setTimeout(() => {
        frame.remove();
        preview.dataset["state"] = "failed";
        fallback.hidden = false;
      }, TIMEOUT);
      frame.addEventListener("load", () => {
        window.clearTimeout(timer);
        preview.dataset["state"] = "live";
      });
      frame.src = url;
      preview.dataset["state"] = "loading";
      button.remove();
      preview.append(frame);
      frame.focus();
    });
  }
</script>

<style>
  .deq-projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: var(--deq-space-6);
    margin-block: var(--deq-space-6);
  }
  .deq-project {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--deq-radius);
    overflow: hidden;
  }
  .deq-project-body {
    padding: var(--deq-space-4);
  }
  .deq-project h2 {
    margin: 0;
    font-size: var(--sl-text-h4);
  }
  .deq-project h3 {
    margin: var(--deq-space-4) 0 0;
    font-size: var(--sl-text-base);
  }
  .deq-project p {
    margin: var(--deq-space-2) 0 0;
  }
  .deq-project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--deq-space-4);
    margin-block-start: var(--deq-space-4) !important;
  }
  .deq-project-links a {
    display: inline-block;
    color: var(--sl-color-text-accent);
    min-block-size: 2rem;
    line-height: 2rem;
  }
  .deq-preview {
    position: relative;
    aspect-ratio: 1280 / 800;
    border-block-end: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-gray-6);
  }
  .deq-preview img,
  .deq-preview iframe {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    object-fit: cover;
    object-position: top;
  }
  .deq-preview iframe {
    background: #fff;
  }
  .deq-preview[data-state="loading"] iframe {
    opacity: 0;
  }
  .deq-preview-load {
    position: absolute;
    inset-block-end: var(--deq-space-3);
    inset-inline-start: var(--deq-space-3);
    min-block-size: 2.75rem;
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--sl-color-accent-high, #111);
    color: var(--sl-color-black, #fff);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .deq-preview-load:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .deq-preview-fallback {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    margin: 0;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .deq-showcase-privacy {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
