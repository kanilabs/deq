---
import { getCollection, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Cite from "../../../components/story/Cite.astro";
import Figure from "../../../components/story/Figure.astro";
import Gallery from "../../../components/story/Gallery.astro";
import Lightbox from "../../../components/story/Lightbox.astro";
import SiteLink from "../../../components/story/SiteLink.astro";
import YouTube from "../../../components/story/YouTube.astro";
import { localeParam, localizedPath, useTranslations, type Locale } from "../../../i18n/index.ts";
import { chapterOf, CHAPTERS } from "../../../lib/story.ts";
import "../../../styles/story.css";

export async function getStaticPaths() {
  const entries = (await getCollection("story")).map((entry) => ({ entry, ...chapterOf(entry.id) }));
  return entries.map(({ entry, locale, chapter }) => {
    const siblings = entries.filter((e) => e.locale === locale);
    const at = CHAPTERS.indexOf(chapter);
    const find = (i: number) => siblings.find((e) => e.chapter === CHAPTERS[i]);
    const nav = (e: (typeof entries)[number] | undefined) =>
      e === undefined ? undefined : { chapter: e.chapter, title: e.entry.data.title };
    return {
      params: { locale: localeParam(locale as Locale), chapter },
      props: { entry, locale: locale as Locale, prev: nav(find(at - 1)), next: nav(find(at + 1)) },
    };
  });
}

const { entry, locale, prev, next } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
---

<StarlightPage frontmatter={{ title: entry.data.title, description: entry.data.description }}>
  <Content components={{ Cite, Figure, Gallery, SiteLink, YouTube }} />

  <nav class="deq-chapter-nav" aria-label={t("story.chapters")}>
    {prev !== undefined ? (
      <a href={localizedPath(locale, `story/${prev.chapter}/`)} rel="prev">{t("story.prev")}: {prev.title}</a>
    ) : <a href={localizedPath(locale, "story/")}>{t("story.toc")}</a>}
    {next !== undefined ? (
      <a href={localizedPath(locale, `story/${next.chapter}/`)} rel="next">{t("story.next")}: {next.title}</a>
    ) : <a href={localizedPath(locale, "sources/")}>{t("story.sources")}</a>}
  </nav>
  <Lightbox locale={locale} />
</StarlightPage>
