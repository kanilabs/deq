{
  "name": "deq-monorepo",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Deq: traditional Kurdish tattoo shapes as an open, parametric design system.",
  "license": "GPL-3.0-or-later",
  "author": "0xdolan <0xdolan@gmail.com>",
  "homepage": "https://kanilabs.github.io/deq/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanilabs/deq.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test && vitest run --dir scripts",
    "lint": "pnpm --filter @0xdolan/deq-site exec astro sync && node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
