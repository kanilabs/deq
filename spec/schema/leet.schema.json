{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanilabs.github.io/deq/spec/schema/leet.schema.json",
  "title": "Deq Leet mapping table",
  "description": "Maps the characters of one script to Deq shape compositions on the 24 x 24 grid, for the basic, advanced and full levels (ADR 0015).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "script", "direction", "aliases", "glyphs"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "script": { "enum": ["latin", "sorani"] },
    "direction": { "enum": ["ltr", "rtl"] },
    "aliases": {
      "description": "Characters read as another character of the table (case folding is done before this).",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1 }
    },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["char", "fit", "basic", "advanced", "full"],
        "properties": {
          "char": { "type": "string", "minLength": 1, "maxLength": 1 },
          "fit": {
            "description": "How well the basic glyph reads as the character; `count` marks digits drawn as dot counts.",
            "enum": ["good", "fair", "rough", "count"]
          },
          "basic": { "$ref": "#/$defs/glyph" },
          "advanced": {
            "description": "Alternatives for the advanced level; empty means the basic glyph is used.",
            "type": "array",
            "maxItems": 4,
            "items": { "$ref": "#/$defs/glyph" }
          },
          "full": { "$ref": "#/$defs/glyph" }
        }
      }
    }
  },
  "$defs": {
    "glyph": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape"],
        "properties": {
          "shape": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "params": {
            "type": "object",
            "additionalProperties": { "type": ["integer", "string", "boolean"] }
          },
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "translate": {
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": -24, "maximum": 24 },
                  { "type": "number", "minimum": -24, "maximum": 24 }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "rotate": { "type": "number", "minimum": -360, "maximum": 360 }
            }
          }
        }
      }
    }
  }
}
