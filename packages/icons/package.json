{
  "name": "@0xdolan/deq-icons",
  "version": "1.0.0-rc.1",
  "description": "Deq shapes as icon data, SVG strings, raw SVG files and a sprite.",
  "license": "GPL-3.0-or-later",
  "author": "0xdolan <0xdolan@gmail.com>",
  "homepage": "https://kanilabs.github.io/deq/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanilabs/deq.git",
    "directory": "packages/icons"
  },
  "bugs": "https://github.com/kanilabs/deq/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@0xdolan/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg": {
      "@0xdolan/source": "./src/strings.ts",
      "types": "./dist/strings.d.ts",
      "import": "./dist/strings.js"
    },
    "./svg/*.svg": "./dist/svg/*.svg",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons.json": "./dist/icons.json",
    "./integrity.json": "./dist/integrity.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/files.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "generate": "node scripts/generate.ts",
    "font-data": "node scripts/font-data.ts"
  },
  "dependencies": {
    "@0xdolan/deq-core": "workspace:*"
  },
  "devDependencies": {
    "@0xdolan/deq-exporters": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
