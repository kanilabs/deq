{
  "name": "@0xdolan/deq-exporters",
  "version": "0.0.0",
  "description": "Export Deq shapes to SVG, PDF, AI, PSD, PNG, ICO, JSX and more.",
  "license": "GPL-3.0-or-later",
  "author": "0xdolan <0xdolan@gmail.com>",
  "homepage": "https://kanilabs.github.io/deq/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanilabs/deq.git",
    "directory": "packages/exporters"
  },
  "bugs": "https://github.com/kanilabs/deq/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@0xdolan/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@0xdolan/deq-core": "workspace:*",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "@resvg/resvg-wasm": "2.6.2",
    "ag-psd": "34.1.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "3.5.45",
    "ajv": "8.20.0",
    "svelte": "5.57.3"
  }
}
