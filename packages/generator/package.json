{
  "name": "@0xdolan/deq-generator",
  "version": "1.0.0-rc.1",
  "description": "Deq Leet text generator and pattern generator.",
  "license": "GPL-3.0-or-later",
  "author": "0xdolan <0xdolan@gmail.com>",
  "homepage": "https://kanilabs.github.io/deq/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanilabs/deq.git",
    "directory": "packages/generator"
  },
  "bugs": "https://github.com/kanilabs/deq/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@0xdolan/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate-leet.ts",
    "fixtures": "tsc -p tsconfig.build.json && node scripts/fixtures.ts && node scripts/chart.ts",
    "font-data": "node scripts/font-data.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@0xdolan/deq-core": "workspace:*",
    "valibot": "1.5.0"
  }
}
